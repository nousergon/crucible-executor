[Unit]
Description=Daily v2 trader session, shadow (alpha-engine-config-I11545)

[Timer]
# 09:35 New York time, weekdays (EDT and EST alike; the timezone suffix keeps
# it there across DST): five minutes after the open, once live quotes exist.
# Brian 2026-11-09: no burst of buying and selling at the open. The trader
# now holds its buys for v1's intraday entry triggers (crucible-trader
# `crucible_trader.entry_timing`: a 2% pullback from the day's high, from
# 15:30 within 1% of the sized price, unconditionally at 15:55), so only the
# sells go out at this start and the session runs until the last buy is sent.
# It ran at 14:00 as the interim until that port (set 2026-11-09).
# Inside the box's up-window (started 08:15 ET; stopped by the 01:00 ET
# backstop). The entry point skips NYSE holidays itself.
#
# The session binds to the LAST CLOSED session (crucible.runner), so its
# served day is the previous session, whose predictions the harness
# published after that close.
#
# Persistent=false on purpose. A catch-up run on the next boot would bind to
# that morning's last closed session -- the same day the scheduled 09:35 run
# then binds to -- so a missed session is a missed day, never a double one.
OnCalendar=Mon..Fri *-*-* 09:35:00 America/New_York
Persistent=false
Unit=alpha-engine-trader-session.service

[Install]
WantedBy=timers.target
