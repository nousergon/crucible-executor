[Unit]
Description=Daily v2 trader session, shadow (alpha-engine-config-I11545)

[Timer]
# 14:00 New York time, weekdays (EDT and EST alike; the timezone suffix keeps
# it there across DST). Brian 2026-11-09: no burst of buying and selling at
# the open. Until v1's intraday buy timing (pullback from the high, graduated
# after 14:00, forced at 15:55) is ported into the trader, the one batch runs
# at v1's graduated-entry hour, leaving two hours to fix and rerun a failure
# before the close. Inside the box's up-window (started 08:15 ET; stopped by
# the 01:00 ET backstop). The entry point skips NYSE holidays itself.
#
# The session binds to the LAST CLOSED session (crucible.runner), so its
# served day is the previous session, whose predictions the harness
# published after that close.
#
# Persistent=false on purpose. A catch-up run on the next boot would bind to
# that morning's last closed session -- the same day the scheduled 14:00 run
# then binds to -- so a missed session is a missed day, never a double one.
OnCalendar=Mon..Fri *-*-* 14:00:00 America/New_York
Persistent=false
Unit=alpha-engine-trader-session.service

[Install]
WantedBy=timers.target
