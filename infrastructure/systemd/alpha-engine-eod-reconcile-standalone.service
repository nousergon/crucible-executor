[Unit]
Description=EOD reconciliation (alpha-engine-config-I11066) — component 3's own schedule, independent of the v1 postclose pipeline
After=ibgateway.service
Wants=ibgateway.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/alpha-engine
ExecStart=/home/ec2-user/alpha-engine/.venv/bin/python -m executor.eod_reconcile_standalone
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/home/ec2-user/alpha-engine
Environment=AWS_REGION=us-east-1
Environment=ALPHA_ENGINE_JSON_LOGS=1
Environment=FLOW_DOCTOR_ENABLED=1
Environment=ALPHA_ENGINE_DEPLOYED=1
