[Unit]
Description=v2 trader daily session, shadow (alpha-engine-config-I11545) — crucible_trader.daily_session, a separate system from the v1 units in this directory
After=ibgateway.service network-online.target
Wants=ibgateway.service network-online.target
# alpha-engine-config-I12353: a run that ends failed, wherever it died (provisioning,
# the pinned venv build, the trader), pages through alpha-engine-trader-failed@.
# The notifier only reports; it never retries or touches this unit.
OnFailure=alpha-engine-trader-failed@%n.service alpha-engine-v2-trade-alert.service
# alpha-engine-config-I13005: every session ending, ok or not, sends its trades
# and a summary to Telegram (the v2 trader itself has no Telegram path).
OnSuccess=alpha-engine-v2-trade-alert.service

[Service]
Type=oneshot
User=ec2-user
# Not the crucible-trader checkout: it may not exist until ExecStartPre has
# cloned it, and systemd applies WorkingDirectory to ExecStartPre too.
WorkingDirectory=/home/ec2-user
# The trader's whole environment: store URI, gateway address, its own IB
# client id (never v1's 1, 2 or 3), order routing held off, and
# the AWS profile that assumes the crucible-v2-trader role. It is PRIVATE
# config, so it lives in alpha-engine-config (pulled by boot-pull.sh) and not
# in this public repository. No leading '-': a missing file fails the unit
# rather than running the trader against defaults it does not have.
EnvironmentFile=/home/ec2-user/alpha-engine-config/crucible-trader/trader.env
# alpha-engine-config-I13544: refuse a start outside Mon-Fri 09:25-16:00 ET
# before anything runs. A changed timer replaced by boot-pull on a box up
# since the morning fired this unit at 20:36 ET (11-09) and 20:38 ET (11-10);
# the trader held, but still wrote a held run manifest the sweep paged on.
# ExecCondition= runs before ExecStartPre=; exit 1 skips quietly (no
# provisioning, no trader, Result=exec-condition, no OnFailure=). Exit 255,
# the gate's answer when it cannot read the clock, fails the unit and pages.
ExecCondition=/usr/bin/env bash /home/ec2-user/alpha-engine/infrastructure/session-hours-gate.sh
ExecStartPre=/usr/bin/env bash /home/ec2-user/alpha-engine/infrastructure/trader-provision.sh
# SHADOW: with routing off the session resolves the champion, builds the book,
# records the served day and files a no_orders shortfall. No order leaves the
# trader. Its hold-book safeguard reads the paper account through a READ-ONLY
# gateway session and cannot cancel or close anything.
ExecStart=/usr/bin/env bash /home/ec2-user/crucible-trader/scripts/trader_pinned.sh daily_session
# 395 minutes: a hard stop at 16:05 ET. The session holds its buys until
# their entry trigger, at the latest the 15:55 expiry (earlier on a half day),
# then waits up to 30 s for each fill and files the day. The stop leaves that
# ten minutes and ends five minutes before the 16:10 pin smoke, which shares
# this session's IB client id. A stop that fires mid-day is a SIGTERM the
# harness records as a failed run; the orders already sent are on the record.
TimeoutStartSec=395min
StandardOutput=journal
StandardError=journal
