[Unit]
Description=v2 trader broker reconciliation (alpha-engine-config-I11071) — trader.reconcile, a separate system from the v1 units in this directory
After=ibgateway.service network-online.target
Wants=ibgateway.service network-online.target

[Service]
Type=oneshot
User=ec2-user
# alpha-engine-config-I11545 settled the two things this unit used to leave
# open. The checkout is /home/ec2-user/crucible-trader, provisioned by the
# ExecStartPre below (it did not exist on the box before). The environment is
# the trader's one env file in alpha-engine-config: this unit used to name
# /etc/crucible-trader/reconcile.env, which nothing wrote, so it failed on
# every run. `trader_reconcile.sh` connects to the gateway READ-ONLY.
WorkingDirectory=/home/ec2-user
EnvironmentFile=/home/ec2-user/alpha-engine-config/crucible-trader/trader.env
ExecStartPre=/usr/bin/env bash /home/ec2-user/alpha-engine/infrastructure/trader-provision.sh
ExecStart=/usr/bin/env bash /home/ec2-user/crucible-trader/scripts/trader_reconcile.sh
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
