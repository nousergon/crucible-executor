[Unit]
Description=Daily broker reconciliation for the v2 trader (alpha-engine-config-I11071)

[Timer]
# 16:45 New York time, weekdays: 45 minutes after the NYSE close, so the
# day's fills have settled on the IB paper account, and the job binds to
# TODAY's session (the last closed one).
#
# It was 21:35 UTC until alpha-engine-config-I11545. CloudTrail shows the v1
# postclose pipeline stopping this box between 21:11 and 21:47 UTC
# (2026-09-11 to -24), so on four of those ten sessions the box was already
# down at 21:35. 16:45 New York is 20:45 UTC in EDT, clear of every measured
# stop, and the timezone suffix keeps it after the close in EST. This is the
# v2 trader's OWN reconciliation (trader.reconcile, alpha-engine-config-
# I10651/-I11071), independent of the v1 eod-reconcile and reference-rate
# timers in this directory.
#
# Persistent=false since alpha-engine-config-I12376. The v1 postclose
# pipeline (nousergon-data ne-postclose-trading-pipeline) now stops this box
# at ~16:01 New York, before 16:45, so this timer almost never fires on time:
# the reconcile used to run only as a boot catch-up at the evening
# ne-postclose-reconcile-pipeline boot, and when that boot landed after
# 00:00 UTC IB returned none of the session's executions, so every share and
# cash delta of the day read as a discrepancy (10-19 and 10-20). The
# postclose pipeline now STARTS alpha-engine-trader-reconcile.service itself,
# after CaptureSnapshot and before it stops the box, and waits for it
# (step_function_eod.json DrainTraderReconcile). A boot catch-up after that
# is not idempotent: `trader.reconcile` writes one manifest per trading day
# and a run after 00:00 UTC would overwrite the good one with a run that saw
# no fills. So no catch-up. The 16:45 schedule stays as an on-time backstop
# for a day the box is still up then, when a second same-day run re-files
# the same result.
OnCalendar=Mon..Fri *-*-* 16:45:00 America/New_York
Persistent=false
Unit=alpha-engine-trader-reconcile.service

[Install]
WantedBy=timers.target
