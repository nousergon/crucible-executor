[Unit]
Description=Telegram announcement of the v2 trader's pre-open order book (alpha-engine-config-I12024)
# Started by alpha-engine-trader-order-book-plan.service through OnSuccess=.
# It never starts, retries or touches the trader: it reads the book the plan
# wrote (as the trader's role, via the profile in the trader's env file, which
# it reads itself) and sends one essential message through the executor's
# existing Telegram path, once per day. It runs from the EXECUTOR's venv.
# It exits non-zero when the book is unreadable or the message was not
# delivered, and that pages through the notifier the trader units use.
OnFailure=alpha-engine-trader-failed@%n.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/alpha-engine
ExecStart=/home/ec2-user/alpha-engine/.venv/bin/python -m executor.v2_order_book_alert
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/home/ec2-user/alpha-engine
Environment=AWS_REGION=us-east-1
Environment=ALPHA_ENGINE_JSON_LOGS=1
Environment=FLOW_DOCTOR_ENABLED=1
Environment=ALPHA_ENGINE_DEPLOYED=1
