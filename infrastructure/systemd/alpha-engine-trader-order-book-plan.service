[Unit]
Description=v2 trader pre-open order book (alpha-engine-config-I12024) — crucible_trader.order_book_plan, no order and no router, a separate system from the v1 units in this directory
After=ibgateway.service network-online.target
Wants=ibgateway.service network-online.target
# alpha-engine-config-I12353: a run that ends failed, wherever it died (provisioning,
# the pinned venv build, the trader), pages through alpha-engine-trader-failed@.
# The notifier only reports; it never retries or touches this unit.
OnFailure=alpha-engine-trader-failed@%n.service
# Brian 2026-11-09/10: the pre-open book is the one announced on Telegram, once
# a day. The alert reads the book this unit wrote and sends nothing when there
# is none (a held day) or it was announced already.
OnSuccess=alpha-engine-v2-order-book-alert.service

[Service]
Type=oneshot
User=ec2-user
# Not the crucible-trader checkout: it may not exist until ExecStartPre has
# cloned it, and systemd applies WorkingDirectory to ExecStartPre too.
WorkingDirectory=/home/ec2-user
# The trader's one env file (store URI, gateway address, the routing decision,
# the AWS profile for the trader identity). No leading '-': a missing file
# fails the unit.
EnvironmentFile=/home/ec2-user/alpha-engine-config/crucible-trader/trader.env
# The plan's OWN IB client id. With routing on it reads the paper account's
# positions through a READ-ONLY gateway session, and IB refuses a second
# connection on an id in use, so it never shares one: not the session's (the
# pin smoke shares that one), not the reconcile's master id, not v1's 1-3.
# crucible_trader.order_book_plan refuses any of those itself. trader.env does
# not set this variable, so this line is what the plan reads.
Environment=CRUCIBLE_TRADER_PLAN_IB_CLIENT_ID=43
ExecStartPre=/usr/bin/env bash /home/ec2-user/alpha-engine/infrastructure/trader-provision.sh
# Builds the day's order book from the session's own inputs and writes it,
# create-only, at trader/order_books/{day}.json before the open. It places no
# order and builds no router. On a held day (no feed yet, a degenerate feed,
# the kill switch) it writes nothing and exits 0; the session then holds too.
ExecStart=/usr/bin/env bash /home/ec2-user/crucible-trader/scripts/trader_pinned.sh order_book_plan
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
