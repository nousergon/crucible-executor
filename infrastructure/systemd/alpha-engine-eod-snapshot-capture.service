[Unit]
Description=EOD broker snapshot capture at the close (alpha-engine-config-I13663)
After=ibgateway.service
Wants=ibgateway.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/alpha-engine
# Never capture while the v2 trader session is still running: its last buys
# go out from 15:55, and a capture before their fills would freeze a book
# without them. Exit 1 here skips the run (not a failure); the 21:05 / 21:15
# UTC capturers then write the snapshot as they do today.
ExecCondition=/bin/sh -c '! systemctl is-active --quiet alpha-engine-trader-session.service'
ExecStart=/home/ec2-user/alpha-engine/.venv/bin/python -m executor.snapshot_capturer
# The capture waits up to 420 s for IB Gateway (GATEWAY_READY_TIMEOUT_S).
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/home/ec2-user/alpha-engine
Environment=AWS_REGION=us-east-1
Environment=ALPHA_ENGINE_JSON_LOGS=1
Environment=FLOW_DOCTOR_ENABLED=1
Environment=ALPHA_ENGINE_DEPLOYED=1
